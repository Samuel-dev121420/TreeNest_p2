# Konfigurasi Firebase TreeNest Sanctuary
# Salin file ini menjadi .env.local dan isi dengan konfigurasi dari Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email akun Admin — akun dengan email ini otomatis mendapat akses fitur moderasi TreeGallery
# Pastikan email ini sudah terdaftar di Firebase Authentication
VITE_ADMIN_EMAIL=
